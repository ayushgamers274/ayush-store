# Copy to .env and fill in (optional — everything works without it locally)

# Port to listen on
PORT=3000

# First admin account (created automatically on first run if no admin exists)
ADMIN_EMAIL=admin@ayush.dev
ADMIN_PASSWORD=change-me-strong-password

# PostgreSQL (only needed if using Render/Neon or another managed Postgres)
DATABASE_URL=postgres://user:password@host:5432/dbname
